# Copiese a .env y ajustese. .env no se sube al repositorio.

# --- Desarrollo (npm run dev) ---------------------------------------------------------------------
# A donde reenvia Vite las llamadas a /api: el gateway de mto-platform publicado en el host.
MTO_DEV_GATEWAY_URL=http://localhost:8090

# --- Contenedor (docker compose up) ---------------------------------------------------------------
# 4200 es el redirect URI del cliente mto-frontend en el realm.
APP_PORT=4200
# El realm de Keycloak, tal como lo ve el navegador (el 'iss' de los tokens).
MTO_OIDC_AUTHORITY=http://auth.mto.local:8082/realms/mto
MTO_OIDC_CLIENT_ID=mto-frontend
# El gateway visto desde el contenedor (en la red de mto-platform, por su nombre de servicio).
# MTO_GATEWAY_URL=http://gateway:8090
# La etiqueta del entorno que se ve en la cabecera (vacia en produccion).
MTO_ENVIRONMENT=local
# El backoffice, tal como lo ve el navegador: «Abrir en el backoffice», en la barra, lleva a la misma
# pantalla allí. Vacío, la barra no lo ofrece.
MTO_BACKOFFICE_URL=http://localhost:8085

# --- Pruebas de punta a punta (npm run e2e), con la plataforma levantada ---------------------------
E2E_BASE_URL=http://localhost:4200
E2E_PASSWORD=local
# Solo en el entorno de la nube de Claude, que trae su propio Chromium; en tu maquina basta con
# `npx playwright install chromium` una vez.
# PW_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium
